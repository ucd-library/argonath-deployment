# Copy to .env in this directory and fill in real values. .env is gitignored.

# Samwise AI platform
SAMWISE_API_KEY=
SAMWISE_API_URL=http://samwise.library.ucdavis.edu/api

# CaskFS
CASK_ROOT=http://cask:3001

# Dagster / dedicated dagster-postgres
DAGSTER_POSTGRES_DB=dagster

# Superset
SUPERSET_REMOTE_AUTH=true
SUPERSET_SECRET_KEY=

# OIDC (realm: internal, client: argonath)
OIDC_BASE_URL=https://auth.library.ucdavis.edu/realms/internal
OIDC_CLIENT_ID=argonath
OIDC_CLIENT_SECRET=
OIDC_REALM_NAME=internal
JWT_SECRET=

# Docker images — until argonath has its own .cork-build, these need to be
# pointed at either a manually-built local image or an existing upstream tag.
IMAGE_PROJECT_ANDUIN_ANDUIN_PG=us-west1-docker.pkg.dev/digital-ucdavis-edu/pub/anduin-pg:main
IMAGE_ARGONATH_DAGSTER=
IMAGE_ARGONATH_CASK=
IMAGE_ARGONATH_GATEWAY=
IMAGE_ARGONATH_SUPERSET=
IMAGE_ARGONATH_DC=argonath-dc:dev
