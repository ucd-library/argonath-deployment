# This file is for reference only - cmds/digtk-dev/update.sh overwrites the
# real .env in this directory from the `digtk-dev-dot-env` secret in GCP
# Secret Manager (project argonath-508815). There's no manual copy step.

# Samwise AI platform
SAMWISE_API_KEY=
SAMWISE_API_URL=http://samwise.library.ucdavis.edu/api

# CaskFS
CASK_ROOT=http://cask:3001

# Dagster / dedicated dagster-postgres
DAGSTER_POSTGRES_DB=dagster

# Superset
SUPERSET_REMOTE_AUTH=true
SUPERSET_SECRET_KEY=1234567890

# Preservica
PRESERVICA_TENANT=
PRESERVICA_USERNAME=
PRESERVICA_PASSWORD=
CASK_TRUSTED_USER=dagster
CASK_API_URL=http://cask:3001/cask/api

# OIDC (realm: internal, client: argonath)
OIDC_BASE_URL=https://auth.library.ucdavis.edu/realms/internal
OIDC_CLIENT_ID=argonath
OIDC_CLIENT_SECRET=
OIDC_REALM_NAME=internal
JWT_SECRET=1234567890
OIDC_ROLES_CLAIM_PATHS=resource_access.argonath.roles

# Note: no IMAGE_* vars here - compose.yaml hardcodes every image to
# us-west1-docker.pkg.dev/argonath-508815/argo-dev/<image>:dev
