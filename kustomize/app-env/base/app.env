CASK_URL=http://cask:3001
DAGSTER_URL=http://dagster-ui:3000

SUPERSET_REMOTE_AUTH=true
SUPERSET_APP_ROOT=/superset

OIDC_BASE_URL=https://auth.library.ucdavis.edu/realms/internal
OIDC_CLIENT_ID=argonath
OIDC_REALM_NAME=internal

CASKFS_ROOT_DIR=/opt/cache
CASKFS_ACL_ENABLED=false
CASKFS_WEBAPP_PORT=3001
CASKFS_WEBAPP_PATH_PREFIX=/cask

# Shared postgres (cask, anduin-gateway, superset)
CASKFS_PG_HOST=postgres
POSTGRES_USER=postgres

# Dedicated postgres for dagster (heavy read/write load during pipeline runs)
DAGSTER_POSTGRES_HOST=dagster-postgres
DAGSTER_POSTGRES_USER=postgres
DAGSTER_POSTGRES_DB=dagster

SAMWISE_API_URL=http://samwise.library.ucdavis.edu/api
