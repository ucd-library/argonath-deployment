CASK_URL=http://cask:3001
DAGSTER_URL=http://dagster-ui:3000

SUPERSET_REMOTE_AUTH=true
SUPERSET_APP_ROOT=/superset

OIDC_BASE_URL=https://auth.library.ucdavis.edu/realms/internal
OIDC_CLIENT_ID=argonath
OIDC_REALM_NAME=internal

ANDUIN_APP_URL=https://argonath.library.ucdavis.edu

CASKFS_ROOT_DIR=/opt/cache
CASKFS_ACL_ENABLED=false
CASKFS_WEBAPP_PORT=3001
CASKFS_WEBAPP_PATH_PREFIX=/cask

# Shared postgres (cask, anduin-gateway, superset)
CASKFS_PG_HOST=postgres
POSTGRES_USER=postgres

# Dedicated postgres for dagster (heavy read/write load during pipeline runs)
DAGSTER_POSTGRES_HOST=dagster-postgres
DAGSTER_POSTGRES_PORT=5432
DAGSTER_POSTGRES_USER=postgres
DAGSTER_POSTGRES_DB=dagster

# dagster -> cask (names differ from anduin-gateway's CASK_URL above, matching local-dev)
CASK_API_URL=http://cask:3001/cask/api
CASK_TRUSTED_USER=dagster
CASK_ROOT=http://cask:3001

# digtk CLI (shares the main "postgres" instance, not dagster-postgres)
DIGTK_POSTGRES_HOST=postgres
DIGTK_POSTGRES_DB=postgres
DIGTK_POSTGRES_USER=postgres
DIGTK_REPORTING_PG_HOST=postgres
DIGTK_REPORTING_PG_DATABASE=postgres
DIGTK_REPORTING_PG_USER=postgres

# Elasticsearch (deployed separately, in the dc-showcase namespace/deployment repo)
DAMS_ES_HOST=http://elasticsearch.dc-showcase.svc.cluster.local:9200
DAMS_ES_INDEX=item-write

# anduin-gateway role mapping
OIDC_ROLES_CLAIM_PATHS=resource_access.argonath.roles

# Preservica (tenant is non-secret config; see PRESERVICA_USERNAME/PASSWORD secrets)
PRESERVICA_TENANT=starter1

SAMWISE_API_URL=http://samwise-api.library.ucdavis.edu/v1
